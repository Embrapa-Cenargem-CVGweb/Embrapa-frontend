# ═══════════════════════════════════════════════════════════
# .gitignore - Embrapa Cenargen Frontend
# ═══════════════════════════════════════════════════════════

# ─── Dependencies ───────────────────────────────────────────
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# ─── Build & Distribution ───────────────────────────────────
dist/
build/
*.min.js
*.min.css
.next/
out/

# ─── Environment Variables ──────────────────────────────────
.env
.env.local
.env.*.local
.env.development.local
.env.test.local
.env.production.local

# ─── IDE & Editor ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
*.sublime-project
*.sublime-workspace
.emacs*
*#
.#*
*.iml
.c9/
*.launch
.settings/
*.sublime-workspace

# ─── Operating System ───────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
desktop.ini

# ─── Logs ────────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Testing ─────────────────────────────────────────────────
.nyc_output/
coverage/
*.lcov
.jest-cache/
.mocha_output/

# ─── Temporary Files ─────────────────────────────────────────
tmp/
temp/
cache/
*.tmp
*.temp
*.bak
*.orig

# ─── Browser Extensions & Add-ons ──────────────────────────
.eslintcache
.stylelintcache
.prettier-ignore

# ─── Database Files ──────────────────────────────────────────
*.db
*.sqlite
*.sqlite3
*.sql

# ─── Local Development ───────────────────────────────────────
.localrc
config.local.js
local.config.js
.development.env

# ─── Package Manager Caches ──────────────────────────────────
.npm/
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ─── Documentation Builds ───────────────────────────────────
docs/_build/
site/

# ─── Backup Files ────────────────────────────────────────────
*.backup
*.bckup
*.old

# ─── User Specific Files ─────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/extensions.json
!.vscode/extensions.json
*.code-workspace

# ─── Project Specific ────────────────────────────────────────
# Arquivos de teste local
test-results/
test-output/

# Arquivos temporários de build
.cache/
.parcel-cache/

# Dados sensíveis
credentials.json
secrets.json
api-keys.json

# ─── Keep These (Optional) ───────────────────────────────────
# Descomente se quiser manter alguns arquivos
# !.gitkeep
# !important-file.txt

# Cópia dos arquivos antes do refactor de design (apagar quando não precisar)
.pre-refactor-backup/
