{
  "name": "embrapa-cenargen-frontend",
  "version": "2.0.0",
  "description": "CVGWeb — interface de gestão dos campos experimentais e casas de vegetação da Embrapa Cenargen",
  "author": "Embrapa Cenargen",
  "license": "MIT",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/build-icons.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "test:admin": "playwright test -c playwright.demo.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.0"
  },
  "keywords": [
    "embrapa",
    "cenargen",
    "cvgweb",
    "casas-de-vegetacao",
    "reservas"
  ]
}
